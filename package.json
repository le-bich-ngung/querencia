{
  "name": "querencia",
  "version": "0.1.0",
  "private": true,
  "description": "Querencia ecosystem — Nope · Cùi Bắp · LàNo · Tools",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@querencia/web",
    "dev:api": "turbo dev --filter=@querencia/api",
    "dev:ai": "turbo dev --filter=@querencia/ai-service",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate --filter=@querencia/db",
    "db:migrate": "turbo db:migrate --filter=@querencia/db",
    "db:seed": "turbo db:seed --filter=@querencia/db",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
