# ─── DATABASE ───────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─── REDIS (Upstash) — tách db index ────────────────
UPSTASH_REDIS_URL="rediss://default:[TOKEN]@[HOST].upstash.io:6380"
REDIS_DB0_SESSION_URL="rediss://..."   # Session / Auth tokens
REDIS_DB1_QUOTA_URL="rediss://..."    # Q quota engine
REDIS_DB2_AI_CACHE_URL="rediss://..."  # AI result cache
REDIS_DB3_APP_CACHE_URL="rediss://..."  # App cache / Feed
REDIS_DB4_QUEUE_URL="rediss://..."    # BullMQ jobs

# ─── AUTH (NextAuth.js) ─────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
JWT_ACCESS_SECRET="..."
JWT_REFRESH_SECRET="..."
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── GOOGLE OAUTH ───────────────────────────────────
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# ─── PAYMENT (Paddle) ───────────────────────────────
PADDLE_API_KEY="..."
PADDLE_WEBHOOK_SECRET="..."
PADDLE_ENVIRONMENT="sandbox"  # → "production" khi live

# ─── AI APIs ────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."          # Fallback
AI_BUDGET_CAP_USD_DAILY="10"    # Alert khi vượt

# ─── STORAGE (Cloudflare R2) ────────────────────────
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="querencia-media"
R2_PUBLIC_URL="https://media.querencia.app"

# ─── INTERNAL SERVICE ───────────────────────────────
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_INTERNAL_KEY="..."
API_SERVICE_URL="http://localhost:3001"

# ─── OBSERVABILITY ──────────────────────────────────
SENTRY_DSN="https://...@sentry.io/..."
BETTER_STACK_TOKEN="..."

# ─── APP CONFIG ─────────────────────────────────────
NODE_ENV="development"
PORT_WEB=3000
PORT_API=3001
PORT_AI=8000

# ─── AUTH (bổ sung) ─────────────────────────────────────────
API_PUBLIC_URL="https://querencia.fly.dev"   # URL NestJS backend (để build verify link)
GOOGLE_REDIRECT_URI="https://querencia.fly.dev/api/v1/auth/google/callback"
RESEND_API_KEY="re_..."                      # https://resend.com
